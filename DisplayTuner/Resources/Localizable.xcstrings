        }
      }
    },
    "%@'de %%%lld pil kaldı. Kulaklığınızı şarj edin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has %2$lld%% battery left. Charge your headset."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@'de %%%2$lld pil kaldı. Kulaklığınızı şarj edin."
          }
        }
      }
    },
    "%@'de %%%lld pil kaldı. Mouse'unuzu şarj edin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has %2$lld%% battery left. Charge your mouse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@'de %%%2$lld pil kaldı. Mouse'unuzu şarj edin."
