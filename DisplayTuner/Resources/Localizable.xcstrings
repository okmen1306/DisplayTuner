    "Açıkken monitör her bağlandığında RGB Full'a alınır ve aktif profil (%@) uygulanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the monitor is switched to RGB Full and the active profile (%@) is applied every time it connects."
          }
        }
      }
    },
    "Açılışta başlat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        }
      }
    },
    "Bantları değiştirmek için \"Özel\"i seçin.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose \"Custom\" to change the bands."
          }
        }
      }
    },
    "Bantları sürükleyerek kendi sesini oluştur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the bands to shape your own sound."
          }
        }
      }
    },
    "Bantları yukarı-aşağı sürükle. Değişiklik kulaklığın hafızasına yazılır; Synapse olmadan da kalır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the bands up or down. Changes are saved to the headset memory and stay without Synapse."
          }
        }
      }
    },
