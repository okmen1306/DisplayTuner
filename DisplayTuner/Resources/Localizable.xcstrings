      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        }
      }
    },
    "%100 kulaklığın donanım sınırıdır (Synapse'teki en yüksek seviyeyle aynı).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% is the headset hardware limit (same as the highest level in Synapse)."
          }
        }
      }
    },
    "%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@  ·  tıkla: sonraki  ·  ESC: çık": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  ·  click: next  ·  ESC: exit"
